# Base de datos PostgreSQL (Neon). La integración de Neon en Vercel carga las dos.
DATABASE_URL=
# Conexión directa (sin pooler), usada por las migraciones de Prisma.
DATABASE_URL_UNPOOLED=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET=

# Claves VAPID para las notificaciones push (generarlas con: npm run vapid:generate).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Secreto que Vercel Cron envía en el header Authorization del job de la URBA.
CRON_SECRET=

# Fuente de datos de la URBA: "mock" (datos de data/urba) o "scraper" (sitio oficial).
URBA_FUENTE=mock
